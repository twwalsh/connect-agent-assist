{
  "Version": "2019-10-30",
  "StartAction": "logging-on",
  "Metadata": { "entryPointPosition": { "x": 20, "y": 20 }, "ActionMetadata": {} },
  "Actions": [
    {
      "Identifier": "logging-on",
      "Type": "UpdateFlowLoggingBehavior",
      "Parameters": { "FlowLoggingBehavior": "Enabled" },
      "Transitions": { "NextAction": "recording" }
    },
    {
      "Identifier": "recording",
      "Type": "UpdateContactRecordingBehavior",
      "Parameters": {
        "RecordingBehavior": { "RecordedParticipants": [ "Agent", "Customer" ] },
        "AnalyticsBehavior": {
          "Enabled": "True",
          "AnalyticsLanguage": "en-US",
          "AnalyticsRedactionBehavior": "Enabled",
          "AnalyticsRedactionResults": "RedactedAndOriginal",
          "ChannelConfiguration": { "Voice": { "AnalyticsModes": [ "PostContact" ] } },
          "SentimentConfiguration": { "Enabled": "True" }
        }
      },
      "Transitions": { "NextAction": "set-queue" }
    },
    {
      "Identifier": "set-queue",
      "Type": "UpdateContactTargetQueue",
      "Parameters": { "QueueId": "${queue_arn}" },
      "Transitions": { "NextAction": "greet", "Errors": [ { "NextAction": "sorry", "ErrorType": "NoMatchingError" } ] }
    },
    {
      "Identifier": "greet",
      "Type": "MessageParticipant",
      "Parameters": { "Text": "You have reached the Fruitless Research support desk, a one-person proof of concept. This call is recorded and transcribed. Checking whether someone is available." },
      "Transitions": { "NextAction": "staffed", "Errors": [ { "NextAction": "staffed", "ErrorType": "NoMatchingError" } ] }
    },
    {
      "Identifier": "staffed",
      "Type": "CheckStaffing",
      "Parameters": { "Status": "Available" },
      "Transitions": {
        "NextAction": "nobody",
        "Conditions": [
          { "NextAction": "to-queue", "Condition": { "Operator": "Equals", "Operands": [ "True" ] } },
          { "NextAction": "nobody", "Condition": { "Operator": "Equals", "Operands": [ "False" ] } }
        ],
        "Errors": [ { "NextAction": "nobody", "ErrorType": "NoMatchingError" } ]
      }
    },
    {
      "Identifier": "to-queue",
      "Type": "TransferContactToQueue",
      "Parameters": {},
      "Transitions": { "NextAction": "end", "Errors": [ { "NextAction": "sorry", "ErrorType": "QueueAtCapacity" }, { "NextAction": "sorry", "ErrorType": "NoMatchingError" } ] }
    },
    {
      "Identifier": "nobody",
      "Type": "MessageParticipant",
      "Parameters": { "Text": "Nobody is at the desk right now. Please use the contact form at fruitless research dot com. Goodbye." },
      "Transitions": { "NextAction": "end", "Errors": [ { "NextAction": "end", "ErrorType": "NoMatchingError" } ] }
    },
    {
      "Identifier": "sorry",
      "Type": "MessageParticipant",
      "Parameters": { "Text": "Something went wrong on our side. Please try again in a moment. Goodbye." },
      "Transitions": { "NextAction": "end", "Errors": [ { "NextAction": "end", "ErrorType": "NoMatchingError" } ] }
    },
    {
      "Identifier": "end",
      "Type": "DisconnectParticipant",
      "Parameters": {},
      "Transitions": {}
    }
  ]
}
